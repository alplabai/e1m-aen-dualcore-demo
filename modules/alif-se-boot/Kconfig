# Out-of-tree Zephyr module root Kconfig for alif_se_boot (see
# zephyr/module.yml: build.kconfig = "Kconfig").

config ALIF_SE_BOOT
	bool "Alif E8 Secure-Enclave boot-CPU service client"
	default y if DT_HAS_ALPLAB_E8_SE_BOOT_ENABLED
	help
	  Client for the Alif Secure Enclave's BOOT_CPU service (service_id 501),
	  used to release/boot a secondary RTSS core (e.g. RTSS-HE) from the core
	  that already has SE access (RTSS-HP). Talks to the SE directly over a
	  DEDICATED pair of ARM MHUv2 frames (mhu@40040000 rx / mhu@40050000 tx --
	  distinct from any inter-core doorbell MHU pair such as the alif_mhuv2
	  module's mhu@400a0000/mhu@400b0000) and carries the request/response in
	  a small non-cacheable SRAM0 carve-out named by this node's
	  `memory-region` property.

	  UNVERIFIED ON SILICON. See modules/alif-se-boot/README.md.
